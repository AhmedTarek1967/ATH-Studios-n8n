    {
      "parameters": {
        "sendTo": "YOUR_SENDTO",
        "subject": "Alert Admin ",
        "message": "=<!DOCTYPE html> <html lang=\"en\"> <head>   <meta charset=\"UTF-8\">   <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">   <title>Critical System Alert</title>   <style>     body, table, td, a {       -webkit-text-size-adjust: 100%;       -ms-text-size-adjust: 100%;     }     table, td {       mso-table-lspace: 0pt;       mso-table-rspace: 0pt;     }     body {       height: 100% !important;       margin: 0 !important;       padding: 0 !important;       width: 100% !important;       background-color: #f8fafc;       font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;     }     @media screen and (max-width: 600px) {       .email-container {         width: 100% !important;         padding: 10px !important;       }       .content-padding {         padding: 24px !important;       }     }   </style> </head> <body style=\"margin: 0; padding: 0; background-color: #f8fafc;\">    <!-- Outer Background Table -->   <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color: #f8fafc; padding: 40px 0;\">     <tr>       <td align=\"center\">                  <!-- Main Email Container -->         <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" class=\"email-container\" style=\"background-color: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid #e2e8f0; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.08);\">                      <!-- Header Banner (Critical Alert Theme) -->           <tr>             <td align=\"center\" style=\"background-color: #DC2626; padding: 36px 20px;\">               <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">                 <tr>                   <td align=\"center\" style=\"background-color: rgba(255, 255, 255, 0.2); width: 48px; height: 48px; border-radius: 50%; font-size: 24px; color: #ffffff; line-height: 48px;\">                     ⚠️                   </td>                 </tr>               </table>               <h1 style=\"color: #ffffff; font-size: 22px; font-weight: 700; margin: 12px 0 0 0; letter-spacing: -0.5px;\">CRITICAL SYSTEM ALERT</h1>               <p style=\"color: #FEE2E2; font-size: 14px; margin: 4px 0 0 0;\">Immediate action required by System Administrator</p>             </td>           </tr>            <!-- Content Body -->           <tr>             <td class=\"content-padding\" style=\"padding: 36px 40px; color: #334155;\">               <p style=\"font-size: 16px; line-height: 1.6; margin: 0 0 16px 0; color: #1E293B;\">                 Hello <strong>System Admin</strong>,               </p>               <p style=\"font-size: 15px; line-height: 1.6; margin: 0 0 24px 0; color: #475569;\">                 An automated monitoring hook detected a critical exception requiring your attention. Below are the execution error details:               </p>                <!-- Incident Details Card -->               <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color: #FEF2F2; border: 1px solid #FCA5A5; border-radius: 8px; margin: 0 0 24px 0;\">                 <tr>                   <td style=\"padding: 20px;\">                     <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">                       <tr>                         <td style=\"padding: 6px 0; font-size: 13px; font-weight: 700; text-transform: uppercase; color: #991B1B; width: 110px;\">Severity:</td>                         <td style=\"padding: 6px 0; font-size: 14px; color: #991B1B;\">                           <span style=\"background-color: #DC2626; color: #ffffff; padding: 2px 8px; border-radius: 4px; font-weight: 600; font-size: 12px;\">CRITICAL</span>                         </td>                       </tr>                       <tr>                         <td style=\"padding: 6px 0; font-size: 13px; font-weight: 700; text-transform: uppercase; color: #991B1B;\">Message:</td>                         <td style=\"padding: 6px 0; font-size: 14px; color: #1E293B; font-family: monospace;\">Example Error Message</td>                       </tr>                     </table>                   </td>                 </tr>               </table>                <!-- Remediation / Fix Instruction Box -->               <p style=\"font-size: 14px; font-weight: 600; color: #1E293B; margin: 0 0 8px 0;\">Recommended Action / Fix:</p>               <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color: #F8FAFC; border-left: 4px solid #DC2626; border-radius: 4px; margin: 0 0 28px 0;\">                 <tr>                   <td style=\"padding: 16px 20px; font-size: 14px; color: #334155; line-height: 1.5; font-family: monospace;\">                     Unrecognised error. Open the execution and read the full error.                   </td>                 </tr>               </table>                <!-- Action CTA Button -->               <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin: 0 0 28px 0;\">                 <tr>                   <td align=\"center\">                     <a href=\"{{ $json.executionUrl }}\" target=\"_blank\" style=\"background-color: #DC2626; color: #ffffff; display: inline-block; font-size: 15px; font-weight: 600; padding: 12px 28px; text-decoration: none; border-radius: 6px; box-shadow: 0 2px 4px rgba(220, 38, 38, 0.2);\">Open Execution Details</a>                   </td>                 </tr>               </table>                <p style=\"font-size: 14px; line-height: 1.5; margin: 0; color: #64748B;\">                 This is an automated alert generated by your monitoring and workflow infrastructure. Please do not reply directly to this email.               </p>             </td>           </tr>            <!-- Footer -->           <tr>             <td align=\"center\" style=\"background-color: #F8FAFC; padding: 20px; border-top: 1px solid #E2E8F0; color: #94A3B8; font-size: 12px;\">               <p style=\"margin: 0;\">Automated System Monitoring &bull; Confidential Infrastructure Alert</p>             </td>           </tr>          </table>        </td>     </tr>   </table>  </body> </html>",
