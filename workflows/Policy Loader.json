{
  "name": "Policy Loader",
  "nodes": [
    {
      "parameters": {
        "resource": "fileFolder",
        "returnAll": true,
        "filter": {
          "driveId": {
            "__rl": true,
            "value": "YOUR_ID",
            "mode": "id"
          },
          "folderId": {
            "mode": "list",
            "value": "root",
            "cachedResultName": "/ (Root folder)"
          },
          "whatToSearch": "files"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        -160,
        0
      ],
      "id": "5a69f51e-70e2-4a2a-bd47-30e6a1098cde",
      "name": "List Policy Files"
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.id }}",
          "mode": "id"
        },
        "options": {
          "googleFileConversion": {
            "conversion": {
              "docsToFormat": "text/plain"
            }
          }
        }
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        64,
        0
      ],
      "id": "734b0651-601e-4f50-a380-f9f80a7c07ef",
      "name": "Download Policy"
    },
    {
      "parameters": {
        "mode": "insert",
        "memoryKey": {
          "__rl": true,
          "value": "hr_policies",
          "mode": "id"
        },
        "clearStore": true
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1.3,
      "position": [
        336,
        32
      ],
      "id": "37dc1c70-6a1e-4944-a94a-667839aa3ccc",
      "name": "Reload Knowledge Base"
    },
    {
      "parameters": {
        "dataType": "binary",
        "textSplittingMode": "custom",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        480,
        208
      ],
      "id": "74dfd0c4-89bc-4b13-8624-6ddf7a85bc44",
      "name": "Read Policy Text"
    },
    {
      "parameters": {
        "chunkOverlap": 200,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        480,
        336
      ],
      "id": "1e31ff25-5f05-41ec-9a82-e697eea0fb0c",
      "name": "Split Into Chunks"
    },
    {
      "parameters": {},
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [
        256,
        224
      ],
      "id": "084b4430-3036-444a-bdaa-d24fc387a92b",
      "name": "Gemini Embeddings"
    },
    {
      "parameters": {
        "events": [
          "init"
        ]
      },
      "type": "n8n-nodes-base.n8nTrigger",
      "typeVersion": 1,
      "position": [
        -656,
        16
      ],
      "id": "ff33a44a-bd22-4644-afcb-099a8064c36b",
      "name": "When n8n Starts"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 7
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        -672,
        288
      ],
      "id": "3ff4d403-2642-416b-bfeb-6108637241ba",
      "name": "Every Morning 7 AM"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -640,
        -208
      ],
      "id": "68db4f12-d53f-4bc1-b642-73d67c0d13d9",
      "name": "Reload Now"
    }
  ],
  "connections": {
    "List Policy Files": {
      "main": [
        [
          {
            "node": "Download Policy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download Policy": {
      "main": [
        [
          {
            "node": "Reload Knowledge Base",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Policy Text": {
      "ai_document": [
        [
          {
            "node": "Reload Knowledge Base",
            "type": "ai_document",
            "index": 0
          }
        ]
      ]
    },
    "Split Into Chunks": {
      "ai_textSplitter": [
        [
          {
            "node": "Read Policy Text",
            "type": "ai_textSplitter",
            "index": 0
          }
        ]
      ]
    },
    "Gemini Embeddings": {
      "ai_embedding": [
        [
          {
            "node": "Reload Knowledge Base",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    },
    "When n8n Starts": {
      "main": [
        [
          {
            "node": "List Policy Files",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every Morning 7 AM": {
      "main": [
        [
          {
            "node": "List Policy Files",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reload Now": {
      "main": [
        [
          {
            "node": "List Policy Files",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate"
  },
  "nodeGroups": []
}